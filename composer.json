{
    "name": "libxa/framework",
    "description": "LibxaFrame core framework \u2014 Foundation, Router, Atlas ORM, Blade-X, Reactive, Modules, Frontend Adapters.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/log": "^3.0",
        "workerman/workerman": "^4.1",
        "symfony/console": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "nikic/php-parser": "^5.7",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Libxa\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "squizlabs/php_codesniffer": "^3.9 || ^4.0"
    },
    "extra": {
        "libxa": {
            "providers": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:unit": "phpunit --no-coverage --testsuite Unit",
        "test:feature": "phpunit --no-coverage --testsuite Feature",
        "test:coverage": "phpunit --coverage-text",
        "lint": "@php tools/lint.php",
        "check": [
            "@lint",
            "@test",
            "composer audit --no-interaction"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the full test suite",
        "test:unit": "Run only the unit suite",
        "test:feature": "Run only the feature suite",
        "lint": "Syntax-check every source file",
        "check": "Everything CI runs, locally"
    },
    "support": {
        "issues": "https://github.com/libxa-framework/libxa/issues",
        "source": "https://github.com/libxa-framework/libxa",
        "docs": "https://github.com/libxa-framework/libxa#readme",
        "security": "https://github.com/libxa-framework/libxa/security/policy"
    },
    "authors": [
        {
            "name": "Voukeng Dongmo Franky Steve",
            "email": "libxa@vyloxi.com",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "framework",
        "php",
        "router",
        "orm",
        "blade",
        "websockets",
        "async",
        "fibers"
    ],
    "homepage": "https://github.com/libxa-framework/libxa",
    "config": {
        "sort-packages": true
    }
}